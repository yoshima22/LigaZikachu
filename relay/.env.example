# Porta HTTP/WS do relay
PORT=8080

# Segredo compartilhado entre o SITE e o relay (Bearer nas rotas de controle).
# Gere um valor forte, ex.: openssl rand -base64 32
RELAY_CONTROL_SECRET=

# Limite de lives simultaneas (cada uma consome CPU de transcodificacao).
RELAY_MAX_SESSIONS=3

# Perfil de saida para o YouTube.
RELAY_VIDEO_BITRATE=2500k
RELAY_AUDIO_BITRATE=128k
RELAY_FFMPEG_PRESET=veryfast

# Timeouts (ms)
RELAY_IDLE_TIMEOUT_MS=20000
RELAY_CONNECT_GRACE_MS=120000
