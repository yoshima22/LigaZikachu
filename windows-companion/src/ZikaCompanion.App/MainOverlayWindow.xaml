<Window x:Class="ZikaCompanion.App.MainOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZikaCompanion • protótipo local" Width="340" Height="260"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <!-- WPF vector rendition of Assets/placeholder-mascot.svg. No downloaded art. -->
        <DrawingImage x:Key="Mascot">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#4F456C" Geometry="M 30,70 L 16,10 Q 14,0 24,5 L 54,40 M 78,40 L 110,5 Q 120,0 116,12 L 102,72"/>
                    <GeometryDrawing Brush="#B2F7C6" Geometry="M 32,68 L 23,16 L 48,46 M 86,46 L 109,16 L 99,68"/>
                    <GeometryDrawing Brush="#4F456C" Geometry="M 30,145 Q 12,175 40,166 L 52,152 M 80,152 Q 105,177 109,158 L 101,141 M 103,122 L 132,103 L 122,135 L 145,139 L 108,154 Z"/>
                    <GeometryDrawing Brush="#B2F7C6" Geometry="M 65,43 C 5,43 9,150 50,156 C 109,175 126,47 65,43 Z"/>
                    <GeometryDrawing Brush="#4F456C" Geometry="M 44,80 A 5,7 0 1 0 44,94 A 5,7 0 1 0 44,80 M 84,80 A 5,7 0 1 0 84,94 A 5,7 0 1 0 84,80 M 58,101 Q 65,109 73,101 L 70,106 Q 65,111 60,106 Z"/>
                    <GeometryDrawing Brush="#FF9D9D" Geometry="M 30,98 A 9,6 0 1 0 30,110 A 9,6 0 1 0 30,98 M 94,98 A 9,6 0 1 0 94,110 A 9,6 0 1 0 94,98"/>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>
    </Window.Resources>
    <Grid>
        <Border x:Name="Balloon" Margin="4,4,4,112" Padding="14,12" CornerRadius="18"
                Background="#FFFCF7" BorderBrush="#4F456C" BorderThickness="2"
                Visibility="{Binding HasBalloon, Converter={StaticResource VisibleWhenTrue}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding BalloonTitle}" FontWeight="Bold" Foreground="#332943" Margin="0,0,25,6" TextWrapping="Wrap"/>
                <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Width="24" Height="24"
                        ToolTip="Fechar aviso" AutomationProperties.Name="Fechar aviso" Click="DismissBalloon"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding BalloonMessage}" Foreground="#4F456C" FontSize="13" TextWrapping="Wrap"/>
                </ScrollViewer>
                <TextBlock Grid.Row="2" Text="SIMULAÇÃO LOCAL • fecha em 8 s" FontSize="10" Foreground="#777080" Margin="0,5,0,0"/>
            </Grid>
        </Border>
        <Image Width="118" Height="136" Margin="0,0,24,7" HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Source="{StaticResource Mascot}" RenderTransformOrigin="0.5,1" IsHitTestVisible="False">
            <Image.RenderTransform><TranslateTransform x:Name="Bob"/></Image.RenderTransform>
            <Image.Style>
                <Style TargetType="Image">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsWalking}" Value="False">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="IdleMotion"><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-3" Duration="0:0:1.2"/>
                                </Storyboard></BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="IdleMotion"/></DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsWalking}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="WalkMotion"><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-9" Duration="0:0:0.18"/>
                                </Storyboard></BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="WalkMotion"/></DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasBalloon}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="AlertMotion"><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-16" Duration="0:0:0.3"/>
                                </Storyboard></BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="AlertMotion"/></DataTrigger.ExitActions>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                            <Setter Property="Opacity" Value="0.55"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>
        <TextBlock Text="Zika • local" Foreground="#4F456C" FontSize="10" FontWeight="Bold"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,48,0" IsHitTestVisible="False"/>
    </Grid>
</Window>
