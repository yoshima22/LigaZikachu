<Window x:Class="ZikaCompanion.App.MainOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZikaCompanion • protótipo local" Width="118" Height="136"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False" ShowActivated="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
    </Window.Resources>
    <Grid>
        <Border x:Name="Balloon" Panel.ZIndex="2" Width="324" Height="130" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="14,10" CornerRadius="18"
                Background="#FFFCF7" BorderBrush="#4F456C" BorderThickness="2"
                Visibility="{Binding HasBalloon, Converter={StaticResource VisibleWhenTrue}}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding BalloonTitle}" FontWeight="Bold" Foreground="#332943" Margin="0,0,25,6" TextWrapping="Wrap"/>
                <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top" Width="24" Height="24"
                        ToolTip="Fechar aviso" AutomationProperties.Name="Fechar aviso" Click="DismissBalloon"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding BalloonMessage}" Foreground="#4F456C" FontSize="13" TextWrapping="Wrap"/>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <TextBlock Text="Fecha em 8 s" FontSize="10" Foreground="#777080" Margin="0,5,10,0"/>
                    <Button Content="Abrir site" Click="OpenEventRoute" Margin="0,0,5,0" Visibility="{Binding HasRoute, Converter={StaticResource VisibleWhenTrue}}"/>
                    <Button Content="Coletar expedi&#231;&#227;o" Click="ConfirmAction" Visibility="{Binding HasAction, Converter={StaticResource VisibleWhenTrue}}"/>
                </StackPanel>
            </Grid>
        </Border>
        <Polygon x:Name="BalloonTail" Panel.ZIndex="1" Points="0,0 22,0 19,18" Fill="#FFFCF7" Stroke="#4F456C" StrokeThickness="2"
                 Width="24" Height="20" HorizontalAlignment="Left" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5"
                 Visibility="{Binding HasBalloon, Converter={StaticResource VisibleWhenTrue}}"/>
        <TextBlock x:Name="SleepIndicator" Panel.ZIndex="3" Text="z  Z  z" FontFamily="Segoe UI" FontSize="19"
                   FontWeight="SemiBold" Foreground="#756A99" IsHitTestVisible="False"
                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0"
                   Visibility="{Binding IsSleeping, Converter={StaticResource VisibleWhenTrue}}">
            <TextBlock.RenderTransform><TranslateTransform/></TextBlock.RenderTransform>
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="SleepFloat"><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-7" Duration="0:0:1.1"/>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.55" To="1" Duration="0:0:1.1"/>
                                </Storyboard></BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions><RemoveStoryboard BeginStoryboardName="SleepFloat"/></DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <Image x:Name="Mascot" Width="118" Height="136" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="NearestNeighbor" Cursor="SizeAll" ToolTip="Clique para brincar • arraste para mover • botão direito para opções"
               MouseLeftButtonDown="BeginMascotDrag" MouseMove="MoveMascot" MouseLeftButtonUp="EndMascotDrag" LostMouseCapture="EndMascotDrag">
            <Image.ContextMenu>
                <ContextMenu Opened="OpenMascotMenu">
                    <MenuItem Header="Pausar / Retomar" Click="TogglePause"/>
                    <MenuItem Header="Silenciar / Ativar áudio" Click="ToggleMute"/>
                    <MenuItem x:Name="MascotChoices" Header="Escolher mascote"/>
                    <MenuItem Header="Definir área de ação" Click="DefineArea"/>
                    <MenuItem Header="Tela inteira" Click="ResetArea"/>
                    <MenuItem Header="Restaurar no monitor principal" Click="RestoreMascot"/>
                    <Separator/>
                    <MenuItem Header="Sair" Click="ExitCompanion"/>
                </ContextMenu>
            </Image.ContextMenu>
            <Image.Style>
                <Style TargetType="Image">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSleeping}" Value="True">
                            <Setter Property="Opacity" Value="0.8"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                            <Setter Property="Opacity" Value="0.55"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
        </Image>
    </Grid>
</Window>
