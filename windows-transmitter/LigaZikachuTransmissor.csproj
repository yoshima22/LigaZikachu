<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>LigaZikachuTransmissor</AssemblyName>
    <RootNamespace>LigaZikachu.Transmissor</RootNamespace>
    <Version>0.7.2</Version>
    <ApplicationIcon>Assets\zika-tv.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3405.78" />
    <PackageReference Include="SIPSorcery" Version="10.0.16" />
    <PackageReference Include="SIPSorceryMedia.Encoders" Version="10.0.4" />
    <PackageReference Include="SIPSorceryMedia.Abstractions" Version="10.0.16" />
    <Reference Remove="Microsoft.Web.WebView2.Wpf" />
    <EmbeddedResource Include="Assets\zika-tv-logo.png" />
    <EmbeddedResource Include="native-audio-capture\LICENSE" />
    <EmbeddedResource Include="Assets\SIPSorcery-LICENSE.md" />
    <!-- Capturador WASAPI interno; é extraído apenas em LocalAppData quando usado. -->
    <EmbeddedResource Include="native-audio-capture\x64\Release\ZikaProcessAudioCapture.exe" LogicalName="LigaZikachu.Native.ZikaProcessAudioCapture.exe" />
    <!-- Pastas de distribuição podem conter arquivos .cs de terceiros; nunca são fonte do transmissor. -->
    <Compile Remove="single-file-*\**\*.cs;release-*\**\*.cs;publish-test\**\*.cs" />
  </ItemGroup>
</Project>
